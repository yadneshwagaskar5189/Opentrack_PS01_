# Copy this file to .env and fill in your key.

# ---- LLM (any OpenAI-compatible chat API) ----
# Groq (free key at https://console.groq.com/keys)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Faster/cheaper Groq option:      LLM_MODEL=openai/gpt-oss-20b
# Google Gemini (free tier):       LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                                  LLM_MODEL=<a current Gemini Flash model id from Google AI Studio>
# OpenRouter:                      LLM_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama (no key needed):    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b

# No internet / no key? Offline demo mode that understands a few sample questions:
# LLM_PROVIDER=mock

# ---- App ----
# DB_PATH=institute.db
# Freeze "today": the seed_data CSVs were made for 16 Oct 2026 (then re-run: python -m app.import_csv)
DEMO_TODAY=2026-10-16
# Name shown in the app and in WhatsApp drafts (default comes from the login emails)
# INSTITUTE_NAME=BrightPath Institute
# Week the timetable plans (default: this week Mon-Thu, next week from Friday)
# PLAN_WEEK=2026-10-19
# ONLINE_LICENCES=2
# QUERY_TIMEOUT_MS=3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
